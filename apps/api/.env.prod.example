# API runtime + script env for prod (copy to apps/api/.env.prod)
CROP_ENV=prod
DATABASE_URL=
API_GATEWAY_URL=https://api.cropcopilot.app
NEXT_PUBLIC_API_GATEWAY_URL=https://api.cropcopilot.app
APP_BASE_URL=https://www.cropcopilot.app

# Model + retrieval
RECOMMENDATION_MODEL_PROVIDERS=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
GOOGLE_AI_API_KEY=
OPENAI_API_KEY=
REQUIRE_MODEL_OUTPUT=true
ENABLE_ML_AUTOMATION=false
ENABLE_SAGEMAKER_REALTIME_ENDPOINT=false
DISABLE_RERANKER=1

# Premium
OPENWEATHER_API_KEY=
PREMIUM_PRICING_LOOKUP_MODE=live_then_estimated
PREMIUM_PRICING_ALLOW_ESTIMATED_FALLBACK=true
PRICING_SEARCH_PROVIDER=brave
PRICING_BATCH_MAX_IDS=10
PRICING_BATCH_DAILY_LIVE_LOOKUP_LIMIT=25
PRICING_POSITIVE_CACHE_TTL_MS=604800000
PRICING_NEGATIVE_CACHE_TTL_MS=86400000
PRICING_PAGE_FETCH_LIMIT=2
PRICING_PAGE_FETCH_TIMEOUT_MS=4000
PREMIUM_PRICING_MAX_LIVE_LOOKUPS_PER_CALL=2
PERPLEXITY_API_KEY=
BRAVE_SEARCH_API_KEY=

# Billing (live keys for prod)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_WEBHOOK_SECRET=
ALLOW_BILLING_SIMULATION=false
BILLING_PORTAL_RETURN_URL=https://www.cropcopilot.app/settings/billing

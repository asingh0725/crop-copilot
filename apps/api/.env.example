# Canonical setup:
#   cp apps/api/.env.dev.example apps/api/.env.dev
#   cp apps/api/.env.prod.example apps/api/.env.prod

# Runtime environment selector
CROP_ENV=dev

# Core connectivity
DATABASE_URL=
APP_BASE_URL=http://localhost:3000
API_GATEWAY_URL=http://localhost:3000
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:3000

# Auth verifier (set Cognito OR Supabase vars)
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# LLM/retrieval
RECOMMENDATION_MODEL_PROVIDERS=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
ENABLE_ML_AUTOMATION=false
ENABLE_SAGEMAKER_REALTIME_ENDPOINT=false
DISABLE_RERANKER=1

# Premium + billing
OPENWEATHER_API_KEY=
PREMIUM_PRICING_LOOKUP_MODE=live_then_estimated
PREMIUM_PRICING_ALLOW_ESTIMATED_FALLBACK=true
PRICING_SEARCH_PROVIDER=brave
PRICING_BATCH_MAX_IDS=10
PRICING_BATCH_DAILY_LIVE_LOOKUP_LIMIT=25
PRICING_POSITIVE_CACHE_TTL_MS=604800000
PRICING_NEGATIVE_CACHE_TTL_MS=86400000
PRICING_PAGE_FETCH_LIMIT=2
PRICING_PAGE_FETCH_TIMEOUT_MS=4000
PREMIUM_PRICING_MAX_LIVE_LOOKUPS_PER_CALL=2
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

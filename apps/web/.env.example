# Canonical setup:
#   cp apps/web/.env.dev.example apps/web/.env.dev
#   cp apps/web/.env.prod.example apps/web/.env.prod

# Auth provider
NEXT_PUBLIC_AUTH_PROVIDER=supabase

# Supabase — transitional fallback while Cognito rolls out
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cognito — set these when NEXT_PUBLIC_AUTH_PROVIDER=cognito
NEXT_PUBLIC_COGNITO_REGION=
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_APP_CLIENT_ID=
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# AWS API Gateway — Lambda base URL (deployed via CDK in /infra)
# Both vars should point to the same URL; API_GATEWAY_URL is server-only,
# NEXT_PUBLIC_API_GATEWAY_URL is also exposed to the browser.
API_GATEWAY_URL=https://<api-id>.execute-api.<region>.amazonaws.com
NEXT_PUBLIC_API_GATEWAY_URL=https://<api-id>.execute-api.<region>.amazonaws.com

# Admin access — comma-separated emails allowed to view /admin pages
ADMIN_EMAILS=you@example.com
